# =============================================================================
# 环境变量模板。复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，真实口令与密钥不要提交到版本库。
# =============================================================================

NODE_ENV=development
PORT=3000
# 时区固定，避免 timestamptz 在前后端显示不一致
TZ=Asia/Shanghai

# --- 数据库 -------------------------------------------------------------------
# 开发库
DATABASE_URL="postgresql://staff:CHANGE_ME@127.0.0.1:5432/staff"
# 集成测试库（与开发库分离）。默认不存在，跑测试前需先建库并应用一次表结构：
#   1) 在 sql/00_roles_and_databases.sql 里取消 staff_test 的注释并执行
#   2) cd apps/api && DATABASE_URL="<下面这行>" pnpm exec prisma migrate deploy
# 不设置该变量时，接口测试会整体跳过并打印提示，而不是退回去连开发库。
TEST_DATABASE_URL="postgresql://staff:CHANGE_ME@127.0.0.1:5432/staff_test"
#
# 生产环境：DATABASE_URL 指向生产库，且不要设置 TEST_DATABASE_URL。
# 生产库由部署人员填写，本项目交付时不预置。

# --- 密钥 ---------------------------------------------------------------------
# 管理端会话令牌签名密钥。生成方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME"

# 预留：将来用 pgcrypto（AES-128）加密敏感字段时的对称密钥。
# 本期不落任何加密数据，仅铺通能力。
# 注意：此密钥专用于可逆加密的场景（需要还原显示的数据，如手机号）；
#       口令绝不使用它，口令一律走 scrypt 单向哈希（见 src/lib/password.ts）。
SENSITIVE_FIELD_KEY="CHANGE_ME"

# --- 初始管理员 ---------------------------------------------------------------
# 仅首次 seed 使用；登录后请立即在后台修改口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD="CHANGE_ME"