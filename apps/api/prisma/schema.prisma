// =============================================================================
// 职工素质投票系统 —— 数据模型
// =============================================================================
// 约定：
//   1. 主键统一 UUID v7（`String @id @default(uuid(7))`），由 Prisma 客户端生成。
//      PostgreSQL 17 尚无内置 uuidv7()（PG 18 才引入），因此数据库列不设 DEFAULT，
//      迁移 SQL 里主键为 TEXT NOT NULL 且无默认值，schema 与库之间因此零漂移。
//   2. 时间列一律 `@db.Timestamptz(3)`。Prisma 默认把 DateTime 映射为
//      timestamp(3)（不带时区），在跨时区与夏令时场景下有歧义，
//      PostgreSQL 官方对绝大多数应用推荐 timestamptz。
//   3. 数据库表名与列名统一 snake_case（@@map / @map），让 DBA 直接阅读
//      prisma/migrations 里的手写 SQL 时无认知负担。
//   4. 约束保留 Prisma 的默认命名（`<表>_pkey` / `_key` / `_fkey` / `_idx`）：
//      它本身就是显式且带表名前缀的，已满足「便于 ALTER 与排障」的目标，
//      为此在 schema 里堆几十个 map 参数属于无收益的复杂度。
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 起连接串配置在 prisma.config.ts 的 datasource.url
}

/// 投票场次状态机。draft → voting ⇄ paused → ended（ended 为终态），
/// 只有 voting 状态允许投票；非法流转由服务层拒绝（409 INVALID_SESSION_TRANSITION）。
enum SessionStatus {
  draft
  voting
  paused
  ended

  @@map("session_status")
}

/// 投票场次。各场次的部门/项点/票种/随机码/评分数据经 session_id 隔离，
/// 同库保留历史场次；开放时间窗按场次独立配置（opens_at / closes_at）。
model VoteSession {
  id              String        @id @default(uuid(7))
  name            String        @unique
  status          SessionStatus @default(draft)
  /// 首次 start 的时间；暂停后恢复不覆盖。
  startAt         DateTime?     @map("start_at") @db.Timestamptz(3)
  /// end 的时间；ended 为终态，之后不再变化。
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(3)
  /// 开放开始时间；空 = 不限制开始（状态为 voting 即开放）。
  opensAt         DateTime?     @map("opens_at") @db.Timestamptz(3)
  /// 开放结束时间；空 = 长期开放（状态为 voting 且已到 opensAt 即开放）。
  closesAt        DateTime?     @map("closes_at") @db.Timestamptz(3)
  /// 所属全局部门（字典）。空 = 历史场次，建场次向导之前的存量数据。
  orgDepartmentId String?       @map("org_department_id")
  /// 打分范围：person = 仅个人问卷；both = 个人 + 车间两张问卷都要打分（投票端两表齐填才核销）。
  scoreScope      String        @default("person") @map("score_scope")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  orgDepartment          OrgDepartment?                 @relation(fields: [orgDepartmentId], references: [id], onDelete: Restrict)
  departments            Department[]
  criteria               Criterion[]
  voteColumns            VoteColumn[]
  employees              Employee[]
  ticketTypes            TicketType[]
  ticketBatches          TicketBatch[]
  tickets                Ticket[]
  scoreSheets            ScoreSheet[]
  sheetTicketMap         SheetTicketMap[]
  questionnaireTemplates SessionQuestionnaireTemplate[]

  @@index([orgDepartmentId])
  @@map("vote_sessions")
}

/// 全局部门字典。跨场次复用的部门名单：建场次向导第一步从字典里选部门，
/// 系统随即在场内 departments 插入一条同名部门。被场次引用的字典项不可删除
/// （应用层 409 + 数据库 RESTRICT 兜底），停用即可让它从新场次的下拉里消失。
model OrgDepartment {
  id        String   @id @default(uuid(7))
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions VoteSession[]

  @@map("org_departments")
}

/// 随机码状态。用数据库原生 enum，避免字符串字面量漂移。
enum TicketStatus {
  unused
  used
  revoked

  @@map("ticket_status")
}

/// 后台管理员。支持多账号，权限由角色决定。
model AdminUser {
  id           String   @id @default(uuid(7))
  username     String   @unique
  /// scrypt 格式串：scrypt$N$r$p$salt$hash。绝不可存明文或可逆加密值。
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// 角色。为空表示未分配角色，等价于只读：没有任何写权限。
  roleId String? @map("role_id")

  /// 停用后无法登录，且未过期的会话令牌立即失效（adminAuth 每次请求查库）。
  enabled Boolean @default(true)

  role AdminRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("admin_users")
}

/// 权限目录。权限码的唯一真源在 src/lib/permissions.ts，seed 按 code 幂等同步到本表；
/// 表里存权威副本是为了让角色勾选能走外键，避免权限码在角色表里变成自由文本。
model Permission {
  id        String   @id @default(uuid(7))
  code      String   @unique
  name      String
  groupName String   @map("group_name")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

/// 角色。内置角色（builtin = true）不允许删除，避免把系统锁死在自己改不回来的状态。
model AdminRole {
  id          String   @id @default(uuid(7))
  code        String   @unique
  name        String
  description String?
  builtin     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  admins      AdminUser[]

  @@map("admin_roles")
}

/// 角色与权限的多对多。删除角色或权限时级联清理关联。
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// 部门。打分表按部门取一套项点（行）与被评列（列）。名称在**场次内**唯一。
model Department {
  id        String   @id @default(uuid(7))
  name      String
  sessionId String   @map("session_id")
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// 问卷类型：person = 个人问卷（多个被评职务列），workshop = 车间问卷（单列「得分」）。
  /// 存字符串而不是数据库 enum：问卷形态将来还可能增加，加一种形态不该要求写迁移。
  questionnaireType String @default("person") @map("questionnaire_type")

  employees     Employee[]
  criteria      Criterion[]
  voteColumns   VoteColumn[]
  sheets        ScoreSheet[]
  tickets       Ticket[]
  ticketBatches TicketBatch[]

  session VoteSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, name])
  @@index([sessionId])
  @@map("departments")
}

/// 被评列，即打分表的「列」（主任、党支部书记、车间得分…）。
///
/// 与职工名单（employees）刻意分离：参考表的列是「被评职务」而不是具体职工，
/// 个人问卷有多个职务列、车间问卷只有一个「得分」列，两者共用同一张表表达。
model VoteColumn {
  id           String   @id @default(uuid(7))
  departmentId String   @map("department_id")
  sessionId    String   @map("session_id")
  name         String
  /// 该职务列对应的具体被评人（表头第二行「职务与姓名」里的姓名）。可空：打印空白表时未指定。
  employeeId   String?  @map("employee_id")
  sortOrder    Int      @default(0) @map("sort_order")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  session    VoteSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// 职工被删除后列保留，只是退回「未选人」状态（SetNull）。
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  scoreItems ScoreItem[]

  @@index([departmentId])
  @@index([sessionId])
  @@index([employeeId])
  @@map("vote_columns")
}

/// 被评职工。参考表口径下打分不再按职工，本表保留给后台名单管理与其他用途。
model Employee {
  id           String   @id @default(uuid(7))
  departmentId String   @map("department_id")
  sessionId    String   @map("session_id")
  name         String
  /// 性别：男/女，可空（导入的名单可能缺省）
  gender       String?
  /// 年龄，可空
  age          Int?
  /// 职称，可空
  title        String?
  sortOrder    Int      @default(0) @map("sort_order")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department      Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  session         VoteSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// 该职工被指为某个被评职务列的具体人选（问卷表头「职务与姓名」）。
  voteColumns     VoteColumn[]
  /// 发放留痕：发给该职工的随机码（见 Ticket.assigneeId）。
  assignedTickets Ticket[]

  @@index([departmentId])
  @@index([sessionId])
  @@map("employees")
}

/// 素质项点，即打分表的「行」。min/max 单独设置。
///
/// 两种形态（0010 起）：
/// - 模板项点：departmentId 为空 + templateType 标明归属（person/workshop），
///   每场次每类型一套，问卷配置页编辑的就是它，投票表按部门类型取用；
/// - 部门项点：departmentId 非空、templateType 为空 = 0010 之前的存量行，
///   只为历史 score_items 的外键保留，不再被任何配置或投票链路读取。
model Criterion {
  id           String   @id @default(uuid(7))
  /// 模板项点为 NULL；存量部门项点指向原部门。
  departmentId String?  @map("department_id")
  sessionId    String   @map("session_id")
  /// 模板项点的问卷类型（person/workshop）；部门项点为 NULL。
  templateType String?  @map("template_type")
  name         String
  /// 项点描述（参考表里项点名称下方那段长文字），可空。
  description  String?
  minScore     Int      @default(0) @map("min_score")
  maxScore     Int      @default(100) @map("max_score")
  sortOrder    Int      @default(0) @map("sort_order")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  session    VoteSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  scoreItems ScoreItem[]

  @@index([departmentId])
  @@index([sessionId])
  @@index([sessionId, templateType])
  @@map("criteria")
}

/// 票种（A / B / C ...）。weightPercent 即「占比」，用于最终加权求和。
model TicketType {
  id            String   @id @default(uuid(7))
  sessionId     String   @map("session_id")
  /// 票种编码在场次内唯一：不同场次可以各自有 A/B/C。
  code          String
  name          String
  /// 启用票种的 weightPercent 合计必须为 100，由服务层在写入时校验
  weightPercent Int      @map("weight_percent")
  sortOrder     Int      @default(0) @map("sort_order")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session     VoteSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tickets     Ticket[]
  batches     TicketBatch[]
  scoreSheets ScoreSheet[]

  @@unique([sessionId, code])
  @@index([sessionId])
  @@map("ticket_types")
}

/// 一次批量发码的批次，用于后台按批次追踪发放情况。
model TicketBatch {
  id           String   @id @default(uuid(7))
  ticketTypeId String   @map("ticket_type_id")
  sessionId    String   @map("session_id")
  /// 评议部门绑定；NULL = 不限定（持码人可评全部部门）。
  departmentId String?  @map("department_id")
  count        Int
  operator     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session    VoteSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  /// 部门删除前须先作废/解绑本批次的码（Restrict，不要 SetNull：
  /// SetNull 会把受限码静默退回万能码，等于放宽权限）。
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@index([ticketTypeId])
  @@index([sessionId])
  @@index([departmentId])
  @@map("ticket_batches")
}

/// 随机码。只记录状态与核销时间，**不记录投向**，保证与评分数据的匿名隔断。
model Ticket {
  id           String       @id @default(uuid(7))
  code         String       @unique
  ticketTypeId String       @map("ticket_type_id")
  batchId      String       @map("batch_id")
  sessionId    String       @map("session_id")
  /// 评议部门绑定；NULL = 不限定（持码人可评全部部门）。随批次发码时冗余落列，
  /// 投票链路只读本列，不必 join 批次。
  departmentId String?      @map("department_id")
  /// 领码人（发放留痕）。票不记名：本列只回答「码发给了谁、谁已投」，
  /// 与评分数据（score_sheets 不含 ticketId）在物理上隔断。
  assigneeId   String?      @map("assignee_id")
  status       TicketStatus @default(unused)
  usedAt       DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  session    VoteSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  batch      TicketBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  /// 部门删除前须先作废/解绑本码（Restrict，不要 SetNull：
  /// SetNull 会把受限码静默退回万能码，等于放宽权限）。
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// 职工被删除后发放记录保留，只是退回「未指定领码人」（SetNull）。
  assignee   Employee?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// 提交答卷后写入的受控映射（0..n 张：score_scope=both 一码两张答卷）。
  sheetMaps  SheetTicketMap[]

  @@index([status])
  @@index([batchId])
  @@index([ticketTypeId])
  @@index([sessionId])
  @@index([assigneeId])
  @@index([departmentId])
  @@map("tickets")
}

/// 一张提交的打分表。
/// 匿名边界：本表**不含** ticketId / IP / UA，因此无法从评分反推投票人；
/// 票种只保留到类别粒度（A/B/C），这是加权求和所必需的最小信息。
model ScoreSheet {
  id           String   @id @default(uuid(7))
  departmentId String   @map("department_id")
  ticketTypeId String   @map("ticket_type_id")
  sessionId    String   @map("session_id")
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  department Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  session    VoteSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  ticketType TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  items      ScoreItem[]
  /// 受控映射（可空：启用映射前的历史答卷没有对应行）。反向指向随机码，
  /// 仅 results.export 的导出路径读取，评分与统计链路不使用。
  ticketMap  SheetTicketMap?

  @@index([departmentId])
  @@index([sessionId])
  @@index([ticketTypeId])
  @@map("score_sheets")
}

/// 随机码与答卷的受控映射（按随机码导出答卷用）。
///
/// 匿名边界说明：score_sheets 本身仍不含任何票据标识；本表是唯一的「码 → 答卷」
/// 关联点，仅 results.export 权限的导出路径读取。评分（scoring）与统计（stats /
/// results）链路不 join 本表，因此删除或停用本表不影响任何计分口径。
model SheetTicketMap {
  /// 一码可对应多张答卷：score_scope=both 的场次，持码人要交「个人问卷 + 车间问卷」
  /// 两张表，每张表各一行（复合主键防止同一张表被同一码重复登记）。
  ticketId  String   @map("ticket_id")
  /// 唯一：一张答卷至多来自一个码。
  sheetId   String   @unique @map("sheet_id")
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket  Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sheet   ScoreSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  session VoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([ticketId, sheetId])
  @@index([sessionId])
  @@map("sheet_ticket_map")
}

/// 一个打分单元格。score 为整数，区间由所属项点的 min/max 决定。
model ScoreItem {
  id           String  @id @default(uuid(7))
  sheetId      String  @map("sheet_id")
  /// 个人问卷指向被评职务列；车间问卷整表无被评列，本列为 NULL（0010 起）。
  voteColumnId String? @map("vote_column_id")
  criterionId  String  @map("criterion_id")
  score        Int

  sheet      ScoreSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  voteColumn VoteColumn? @relation(fields: [voteColumnId], references: [id], onDelete: Restrict)
  criterion  Criterion   @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  /// Postgres 唯一索引对 NULL 不去重：车间行 (sheetId, NULL, criterionId) 依赖
  /// criterionId 互异天然防重；个人行维持 (sheet, column, criterion) 唯一。
  @@unique([sheetId, voteColumnId, criterionId])
  @@index([voteColumnId, criterionId])
  @@index([criterionId])
  @@map("score_items")
}

/// 全局设置（当前仅系统标题）。值为字符串，按 key 解析。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// 管理动作留痕：发码、改权重、改开放时间。
model AuditLog {
  id        String   @id @default(uuid(7))
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

/// 场次级问卷模板。个人 / 车间各一套（附件号 + 标题 + 填写说明），
/// 所有同类型部门共用：改一处，全场生效（0010 起取代部门级三件套字段）。
model SessionQuestionnaireTemplate {
  /// 单列代理主键 + 下方 @@unique 保证「每场次每类型一套模板」。
  /// 注意：Prisma 7.10 queryCompiler 对本模型的 API 调用会编译出引用不存在列的
  /// 坏 SQL（P2022 "column (not available)"）；已实测排除复合主键形态、字段名、
  /// 非默认值、模型位置等因素，根因未定位。绕开方式：模板表读写一律走
  /// services/questionnaireTemplateStore.ts 的原生 SQL，不用 prisma.sessionQuestionnaireTemplate。
  id         String   @id @default(uuid(7))
  sessionId  String   @map("session_id")
  /// person = 个人问卷模板，workshop = 车间问卷模板。存字符串，与 departments.questionnaireType 同口径。
  type       String
  /// 表头左上角的附件号（参考表里的「附件1-1」）。
  headerNote String   @default("附件1-1") @map("header_note")
  /// 表标题（参考表里的「xx车间负责人评价问卷」；xx 段在渲染时替换为部门名）。
  title      String   @default("")
  /// 表尾填写说明（参考表里合并整行的说明文字，含满分与弃权口径）。
  footerNote String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session VoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, type])
  @@map("session_questionnaire_templates")
}
